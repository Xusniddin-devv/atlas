ll,411,null,412,null,413,null,414,null,415,null,416,null,417,null,418,null,419,null,420,null,421,null,422,null,423,null,424,null,425,null,426,null,427,null,428,null,429,null,430,null,431,null,432,null,433,null,434,null,435,null,436,null,437,null,438,null,439,null,440,null,441,null,442,null,443,null,444,null,445,null,446,null,447,null,448,null,449,null,450,null,451,null,452,null,453,null,454,null,455,null,456,null,457,null,458,null,459,null,460,null,461,null,462,null,463,null,464,null,465,null,466,null,467,null,468,null,469,null,470,null,471,null,472,null,473,null,474,null,475,null,476,null,477,null,478,null,479,null,480,null,481,null,482,null,483,null,484,null,485,null,486,null,487,null,488,null,489,null,490,null,491,null,492,null,493,null,494,null,495,null,496,null,497,null,498,null,499,null,500]},{"args":[[10,20,11,-1,15,-20,12,-6,-8],[20,10,-1,11,15,12,-20,-6,-8]],"expected":[10,20,11,null,null,-1,15,null,null,null,-20,12,-6,null,null,null,-8]},{"args":[[17,2],[2,17]],"expected":[17,2]},{"args":[[-1],[-1]],"expected":[-1]},{"args":[[-17,-3,12,6,11,17],[-3,-17,6,12,11,17]],"expected":[-17,-3,12,null,null,6,11,null,null,null,17]},{"args":[[17,-17,20],[-17,20,17]],"expected":[17,-17,null,null,20]},{"args":[[14,-10,2,8,-19,15,7,-11],[7,15,-19,8,2,-10,14,-11]],"expected":[14,-10,-11,2,null,null,null,8,null,-19,null,15,null,7]},{"args":[[-6,-2,-3,10,-12,13,16],[-6,-2,-3,-12,13,10,16]],"expected":[-6,null,-2,null,-3,null,10,-12,16,null,13]},{"args":[[-7,2,15,-12,16],[15,2,-12,-7,16]],"expected":[-7,2,16,15,-12]},{"args":[[12,7,2,-13,-10,-1,-15,-20,3],[-1,-10,-13,2,-15,7,12,-20,3]],"expected":[12,7,-20,2,null,null,3,-13,-15,null,null,-10,null,null,null,-1]},{"args":[[7],[7]],"expected":[7]}],"gen":"(r, big) => {\n  const nd = v => ({ v, L: null, R: null });\n  const put = (t, x, b) => { if (!t) return x; let c = t; for (;;) { const k = r.bool(b) ? \"L\" : \"R\"; if (!c[k]) { c[k] = x; return t; } c = c[k]; } };\n  const deep = (len, vals) => { let i = 0; const t = nd(vals[i++]); let c = t; for (; i < len; i++) { const k = r.bool() ? \"L\" : \"R\"; c[k] = nd(vals[i]); c = c[k]; } for (; i < vals.length; i++) put(c, nd(vals[i]), 0.5); return t; };\n  const vals = big ? r.distinct(100000, -1000000000, 1000000000) : r.distinct(r.int(1, 12), -20, 20);\n  let t = null;\n  if (big && r.bool()) t = deep(r.int(300, 420), vals);\n  else { const b = big ? 0.5 : r.pick([0.5, 0.5, 0.2, 0.8]); for (const v of vals) t = put(t, nd(v), b); }\n  const pre = [], ino = [], st = [];\n  for (let n = t; n || st.length;) { while (n) { pre.push(n.v); st.push(n); n = n.L; } n = st.pop(); ino.push(n.v); n = n.R; }\n  return [pre, ino];\n}","hints":["Which list tells you the root immediately? Once you know the root, what does the other list tell you about it?","The first preorder value is the root. Its position in inorder splits inorder into the left subtree and the right subtree, and their sizes tell you where each subtree's part of preorder starts and ends.","Searching inorder for the root at every step costs O(n) each time. Put every value's inorder index in a hash map first, and consume preorder left to right with one shared pointer while recursing on inorder ranges."],"explain":{"intuition":"<p>Preorder always starts with the root. Inorder puts the root <b>between</b> its two subtrees. So: take the root from preorder, find it in inorder, and everything to its left in inorder is the left subtree, everything to its right is the right subtree. The same holds inside each subtree, so recurse.</p>\n<p>Two refinements make it linear. First, look up positions in a hash map instead of scanning inorder each time. Second, notice that preorder visits the root, then the <b>entire</b> left subtree, then the right subtree. If you build the left subtree fully before the right one, the next preorder value is always the root of whatever you are about to build. So one pointer moving left to right through preorder is enough, and each call only needs its inorder range <code>[lo, hi]</code>. An empty range means a null child.</p>","steps":["Map each value to its index in <code>inorder</code>.","Keep a pointer <code>next = 0</code> into <code>preorder</code>.","<code>build(lo, hi)</code>: if <code>lo &gt; hi</code>, return null.","Take <code>val = preorder[next++]</code> as this subtree's root and find its inorder index <code>mid</code>.","Set <code>left = build(lo, mid - 1)</code> first, then <code>right = build(mid + 1, hi)</code>, and return the node. Call <code>build(0, n - 1)</code>."],"pitfalls":["Building the right subtree before the left one while using a single preorder pointer. Preorder lists the left subtree first, so the pointer would hand out the wrong roots.","Scanning or slicing the arrays at every call. It works, but costs O(n · h) time and memory on deep trees.","Ignoring inorder and treating the values as a search tree. These trees are not ordered, so insertion by value builds the wrong shape."],"complexity":{"time":"O(n)","space":"O(n)"}},"solutions":[{"title":"Slice and search at every step","idea":"Root = preorder[0]; find it in inorder; slice both arrays into left and right parts and recurse. Easy to follow, but each level of the tree rescans and copies its range.","time":"O(n · h)","space":"O(n · h)","slow":true,"ts":"function rebuildTree(preorder: number[], inorder: number[]): TreeNode | null {\n  if (!preorder.length) return null;\n  const root = new TreeNode(preorder[0]);\n  const mid = inorder.indexOf(preorder[0]); // size of the left subtree\n  root.left = rebuildTree(preorder.slice(1, mid + 1), inorder.slice(0, mid));\n  root.right = rebuildTree(preorder.slice(mid + 1), inorder.slice(mid + 1));\n  return root;\n}","py":"class Solution:\n    def rebuildTree(self, preorder: List[int], inorder: List[int]) -> Optional[TreeNode]:\n        if not preorder:\n            return None\n        root = TreeNode(preorder[0])\n        mid = inorder.index(preorder[0])  # size of the left subtree\n        root.left = self.rebuildTree(preorder[1:mid + 1], inorder[:mid])\n        root.right = self.rebuildTree(preorder[mid + 1:], inorder[mid + 1:])\n        return root","js":"function rebuildTree(preorder, inorder) {\n  if (!preorder.length) return null;\n  const root = new TreeNode(preorder[0]);\n  const mid = inorder.indexOf(preorder[0]);\n  root.left = rebuildTree(preorder.slice(1, mid + 1), inorder.slice(0, mid));\n  root.right = rebuildTree(preorder.slice(mid + 1), inorder.slice(mid + 1));\n  return root;\n}"},{"title":"Index map and one preorder pointer","idea":"Map values to inorder positions. Recurse on inorder ranges, taking each next root from a pointer that moves through preorder, left subtree first.","time":"O(n)","space":"O(n)","ts":"function rebuildTree(preorder: number[], inorder: number[]): TreeNode | null {\n  const pos = new Map<number, number>();\n  inorder.forEach((v, i) => pos.set(v, i));\n  let next = 0;\n  const build = (lo: number, hi: number): TreeNode | null => {\n    if (lo > hi) return null;\n    const node = new TreeNode(preorder[next++]);\n    const mid = pos.get(node.val)!;\n    node.left = build(lo, mid - 1); // must come first: preorder lists the left subtree next\n    node.right = build(mid + 1, hi);\n    return node;\n  };\n  return build(0, inorder.length - 1);\n}","py":"class Solution:\n    def rebuildTree(self, preorder: List[int], inorder: List[int]) -> Optional[TreeNode]:\n        pos = {v: i for i, v in enumerate(inorder)}\n        nxt = 0\n\n        def build(lo, hi):\n            nonlocal nxt\n            if lo > hi:\n                return None\n            node = TreeNode(preorder[nxt])\n            nxt += 1\n            mid = pos[node.val]\n            node.left = build(lo, mid - 1)  # must come first: preorder lists the left subtree next\n            node.right = build(mid + 1, hi)\n            return node\n\n        return build(0, len(inorder) - 1)","js":"function rebuildTree(preorder, inorder) {\n  const pos = /* @__PURE__ */ new Map();\n  inorder.forEach((v, i) => pos.set(v, i));\n  let next = 0;\n  const build = (lo, hi) => {\n    if (lo > hi) return null;\n    const node = new TreeNode(preorder[next++]);\n    const mid = pos.get(node.val);\n    node.left = build(lo, mid - 1);\n    node.right = build(mid + 1, hi);\n    return node;\n  };\n  return build(0, inorder.length - 1);\n}"}],"followups":["Rebuild from postorder and inorder instead. Where is the root now, and which subtree must you build first?","Why can preorder and postorder together not always rebuild a binary tree? Give two trees with the same pair."],"related":[],"kind":"function","nEx":3,"nBig":2,"lcTitle":"Construct Binary Tree from Preorder and Inorder Traversal","acc":0.006972791476215475,"co":[["TikTok",61,0],["Adobe",55,0],["Bloomberg",52,180],["Media.net",48,180],["Amazon",46,180],["Microsoft",41,180],["Snowflake",39,0],["Google",38,180],["Meta",29,0],["Salesforce",28,0]]}