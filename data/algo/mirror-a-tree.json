ll,null,344,345,null,null,346,347,null,null,348,349,null,null,350,351,null,null,352,353,null,null,354,355,null,null,356,357,null,null,358,359,null,null,360,361,null,null,362,363,null,null,364,365,null,null,366,367,null,null,368,369,null,null,370,371,null,null,372,373,null,null,374,375,null,null,376,377,null,null,378,379,null,null,380,381,null,null,382,383,null,null,384,385,null,null,386,387,null,null,388,389,null,null,390,391,null,null,392,393,null,null,394,395,null,null,396,397,null,null,398,399,null,null,400,401,null,null,402,403,null,null,404,405,null,null,406,407,null,null,408,409,null,null,410,411,null,null,412,413,null,null,414,415,null,null,416,417,null,null,418,419,null,null,420,421,null,null,422,423,null,null,424,425,null,null,426,427,null,null,428,429,null,null,430,431,null,null,432,433,null,null,434,435,null,null,436,437,null,null,438,439,null,null,440,441,null,null,442,443,null,null,444,445,null,null,446,447,null,null,448,449,null,null,450,451,null,null,452,453,null,null,454,455,null,null,456,457,null,null,458,459,null,null,460,461,null,null,462,463,null,null,464,465,null,null,466,467,null,null,468,469,null,null,470,471,null,null,472,473,null,null,474,475,null,null,476,477,null,null,478,479,null,null,480,481,null,null,482,483,null,null,484,485,null,null,486,487,null,null,488,489,null,null,490,491,null,null,492,493,null,null,494,495,null,null,496,497,null,null,498,499,null,null,500]},{"args":[[0,-3,-3,-4,-1,0,null,3,2]],"expected":[0,-3,-3,null,0,-1,-4,null,null,null,null,2,3]},{"args":[[1,-2,1,4,null,2,-2,null,-3]],"expected":[1,1,-2,-2,2,null,4,null,null,null,null,-3]},{"args":[[-1,-1,null,null,1]],"expected":[-1,null,-1,1]},{"args":[[-2,-1,-2,2]],"expected":[-2,-2,-1,null,null,null,2]},{"args":[[0,0,-3,5,null,null,1]],"expected":[0,-3,0,1,null,null,5]},{"args":[[3,-3,0,null,0,5,-3,null,null,null,-2,null,2,null,null,4,1]],"expected":[3,0,-3,-3,5,0,null,2,null,-2,null,null,null,1,4]},{"args":[[-3,null,-2,null,-5,-4,1,null,null,null,-2]],"expected":[-3,-2,null,-5,null,1,-4,-2]},{"args":[[2,-3,null,2,3,-3,null,null,null,-5,-4,4,null,null,null,4,null,null,-3]],"expected":[2,null,-3,3,2,null,null,null,-3,-4,-5,null,null,null,4,null,4,-3]},{"args":[[3,-1,-5,1,-5,1,null,null,1,4,2]],"expected":[3,-5,-1,null,1,-5,1,null,null,2,4,1]},{"args":[[4,5,-2,-1,4,0,null,5,null,null,null,null,null,-4]],"expected":[4,-2,5,null,0,4,-1,null,null,null,null,null,5,null,-4]}],"gen":"(r, big) => {\n  const nd = v => ({ v, L: null, R: null });\n  const put = (t, x, b) => { if (!t) return x; let c = t; for (;;) { const k = r.bool(b) ? \"L\" : \"R\"; if (!c[k]) { c[k] = x; return t; } c = c[k]; } };\n  const rnd = (n, V, b) => { let t = null; for (let i = 0; i < n; i++) t = put(t, nd(V()), b); return t; };\n  const deep = (len, n, V) => { const t = nd(V()); let c = t; for (let i = 1; i < len; i++) { const k = r.bool() ? \"L\" : \"R\"; c[k] = nd(V()); c = c[k]; } for (let i = len; i < n; i++) put(c, nd(V()), 0.5); return t; };\n  const ser = t => { const o = [], q = [t]; for (let i = 0; i < q.length; i++) { const x = q[i]; if (x) { o.push(x.v); q.push(x.L, x.R); } else o.push(null); } while (o.length && o[o.length - 1] === null) o.pop(); return o; };\n  if (big) return [ser(r.bool() ? deep(r.int(300, 450), 20000, () => r.int(-1000, 1000)) : rnd(20000, () => r.int(-1000, 1000), 0.5))];\n  return [ser(rnd(r.int(0, 10), () => r.int(-5, 5), r.pick([0.5, 0.5, 0.2, 0.8])))];\n}","hints":["Mirroring the whole tree means mirroring smaller trees too. What has to be true of the left and right subtrees once you are done?","At a single node the work is tiny: swap the two child pointers. The rest is making sure every node gets visited once.","Recursively: swap <code>left</code> and <code>right</code>, then mirror both children (the order does not matter). Or put nodes in a queue and swap each one as you take it out."],"explain":{"intuition":"<p>Hold the tree up to a mirror. The root stays where it is, the right subtree shows up on the left, and <b>that subtree is itself mirrored</b>. So the mirror of a tree is: same root, children swapped, and each child mirrored the same way. That definition is already the algorithm.</p>\n<p>Every node needs exactly one swap and the swaps do not depend on each other, so any traversal works. Depth-first recursion is the shortest code. A breadth-first queue does the same swaps level by level and never grows the call stack, which matters when a tree can be thousands of levels deep. Think of a DOM tree you want to render right to left: you flip the order of the children at every element, not just at <code>&lt;body&gt;</code>.</p>","steps":["If the node is null, return null.","Swap its <code>left</code> and <code>right</code> pointers.","Mirror the new left subtree and the new right subtree the same way (recursion, or push both onto a queue).","Return the original root. It is still the root of the mirrored tree."],"pitfalls":["Swapping only the root's children. The subtrees move to the other side but keep their old inner order, like in the first example.","Writing <code>root.left = mirror(root.right); root.right = mirror(root.left)</code>. The second line reads the left pointer you just overwrote. Save one side in a variable first, or swap first and recurse after.","Building a new tree but returning the old root, or the other way round. Either mutate in place and return <code>root</code>, or build fresh nodes and return the new one."],"complexity":{"time":"O(n)","space":"O(h) for recursion, O(w) for the queue (h = height, w = widest level)"}},"solutions":[{"title":"Recursive swap (DFS)","idea":"Swap the two children of the current node, then mirror each child. The base case is an empty subtree.","time":"O(n)","space":"O(h)","ts":"function mirrorTree(root: TreeNode | null): TreeNode | null {\n  if (!root) return null;\n  const left = root.left;\n  root.left = mirrorTree(root.right);\n  root.right = mirrorTree(left); // the saved pointer, not root.left\n  return root;\n}","py":"class Solution:\n    def mirrorTree(self, root: Optional[TreeNode]) -> Optional[TreeNode]:\n        if not root:\n            return None\n        root.left, root.right = self.mirrorTree(root.right), self.mirrorTree(root.left)\n        return root","js":"function mirrorTree(root) {\n  if (!root) return null;\n  const left = root.left;\n  root.left = mirrorTree(root.right);\n  root.right = mirrorTree(left);\n  return root;\n}"},{"title":"Queue, level by level (BFS)","idea":"Take nodes from a queue, swap each one's children, and queue the children. No recursion, so tree depth never hits a stack limit.","time":"O(n)","space":"O(w)","ts":"function mirrorTree(root: TreeNode | null): TreeNode | null {\n  const queue: TreeNode[] = root ? [root] : [];\n  for (let i = 0; i < queue.length; i++) { // index instead of shift(): O(1) per step\n    const node = queue[i];\n    [node.left, node.right] = [node.right, node.left];\n    if (node.left) queue.push(node.left);\n    if (node.right) queue.push(node.right);\n  }\n  return root;\n}","py":"class Solution:\n    def mirrorTree(self, root: Optional[TreeNode]) -> Optional[TreeNode]:\n        queue = deque([root] if root else [])\n        while queue:\n            node = queue.popleft()\n            node.left, node.right = node.right, node.left\n            if node.left:\n                queue.append(node.left)\n            if node.right:\n                queue.append(node.right)\n        return root","js":"function mirrorTree(root) {\n  const queue = root ? [root] : [];\n  for (let i = 0; i < queue.length; i++) {\n    const node = queue[i];\n    [node.left, node.right] = [node.right, node.left];\n    if (node.left) queue.push(node.left);\n    if (node.right) queue.push(node.right);\n  }\n  return root;\n}"}],"followups":["Check whether a tree is its own mirror (symmetric) without changing it.","Return a mirrored copy and leave the input tree untouched. What changes in the code?"],"related":[],"kind":"function","nEx":3,"nBig":2,"lcTitle":"Invert Binary Tree","acc":0.008054775097083326,"co":[["Palo Alto Networks",50,0],["josh technology",50,0],["Amazon",42,180],["Google",40,90],["Microsoft",33,90],["Meta",31,180],["LinkedIn",27,0],["Oracle",27,0],["Bloomberg",25,0]]}