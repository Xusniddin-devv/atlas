"16":10,"17":11,"18":12},"notes":{"ts":{},"py":{}}}],"expected":[8,6,10,1,null,null,14],"compare":{"check":"(args, got) => {\n      const [orig, key] = args;\n      const want = orig.filter(v => v !== null && v !== key).sort((a, b) => a - b);\n      if (!Array.isArray(got)) return false;\n      if (got.filter(v => v !== null).length !== want.length) return false;\n      if (!got.length) return want.length === 0;\n      if (got[0] === null) return false;\n      const mk = v => ({ v, l: null, r: null });\n      const root = mk(got[0]), q = [root];\n      let i = 1, qi = 0;\n      while (qi < q.length && i < got.length) {\n        const n = q[qi++];\n        if (i < got.length && got[i] !== null) { n.l = mk(got[i]); q.push(n.l); } i++;\n        if (i < got.length && got[i] !== null) { n.r = mk(got[i]); q.push(n.r); } i++;\n      }\n      if (q.length !== want.length) return false;\n      const out = [], st = [];\n      let cur = root;\n      while (cur || st.length) {\n        while (cur) { st.push(cur); cur = cur.l; }\n        cur = st.pop(); out.push(cur.v); cur = cur.r;\n      }\n      return out.length === want.length && out.every((v, j) => v === want[j]);\n    }"}}