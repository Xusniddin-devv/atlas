l,487,null,488,null,489,null,490,null,491,null,492,null,493,null,494,null,495,null,496,null,497,null,498,null,499,null,null,500]],"expected":false},{"args":[[2,1,0,null,null,1],[2,2]],"expected":false},{"args":[[1],[1,2]],"expected":false},{"args":[[1,2,2,null,1,2,1,null,0],[1,2,1,null,1,2,1,null,0]],"expected":false},{"args":[[2],[1]],"expected":false},{"args":[[],[]],"expected":true},{"args":[[2,2,2],[2,2,2,1,null,0,null,null,null,null,2]],"expected":false},{"args":[[0,1,null,1],[]],"expected":false},{"args":[[0],[0,null,0]],"expected":false},{"args":[[2,null,2,1,0,null,null,null,2,null,0,2],[2,null,2,1,0,null,null,null,2,null,0,2]],"expected":true},{"args":[[0,1,null,null,0],[1,1,null,null,0]],"expected":false}],"gen":"(r, big) => {\n  const nd = v => ({ v, L: null, R: null });\n  const put = (t, x, b) => { if (!t) return x; let c = t; for (;;) { const k = r.bool(b) ? \"L\" : \"R\"; if (!c[k]) { c[k] = x; return t; } c = c[k]; } };\n  const rnd = (n, V, b) => { let t = null; for (let i = 0; i < n; i++) t = put(t, nd(V()), b); return t; };\n  const deep = (len, n, V) => { const t = nd(V()); let c = t; for (let i = 1; i < len; i++) { const k = r.bool() ? \"L\" : \"R\"; c[k] = nd(V()); c = c[k]; } for (let i = len; i < n; i++) put(c, nd(V()), 0.5); return t; };\n  const ser = t => { const o = [], q = [t]; for (let i = 0; i < q.length; i++) { const x = q[i]; if (x) { o.push(x.v); q.push(x.L, x.R); } else o.push(null); } while (o.length && o[o.length - 1] === null) o.pop(); return o; };\n  const copy = t => JSON.parse(JSON.stringify(t));\n  // change one value or add one leaf, somewhere along a random downward walk\n  const tweak = t => { if (!t) return nd(0); let c = t; while (r.bool(0.8)) { const k = r.bool() ? \"L\" : \"R\"; if (!c[k]) break; c = c[k]; } if (r.bool()) c.v += r.pick([-1, 1]); else put(c, nd(c.v), 0.5); return t; };\n  const V = big ? () => r.int(-1000, 1000) : () => r.int(0, 2);\n  const a = big ? deep(r.int(300, 450), 20000, V) : rnd(r.int(0, 7), V, r.pick([0.5, 0.2, 0.8]));\n  const mode = r.int(0, 2);\n  const b = mode === 0 ? copy(a) : mode === 1 ? tweak(copy(a)) : big ? deep(r.int(300, 450), 20000, V) : rnd(r.int(0, 7), V, 0.5);\n  return [ser(a), ser(b)];\n}","hints":["Two trees are identical when their roots match and... what has to be true of the subtrees?","Walk both trees in lockstep. At each step you hold one node from each tree. When are you done early, either way?","<code>same(x, y)</code>: if both are null, true; if exactly one is null, false; if the values differ, false; otherwise <code>same(x.left, y.left) && same(x.right, y.right)</code>."],"explain":{"intuition":"<p>Walk both trees at the same time, step for step, holding one node from each. At every pair there are only three cases: both missing (this branch matches), one missing (the shapes differ), or both present (the values must match, and then both children pairs must match too). The first mismatch anywhere decides the answer.</p>\n<p>This is the same check a virtual DOM diff starts with: compare two trees node by node, and the moment the type, a prop or the child structure differs, you know they are not the same. Comparing flattened value lists is the tempting shortcut, but it drops the shape: <code>[7, 4]</code> and <code>[7, null, 4]</code> both read 7, 4. The <code>null</code> checks are what keep the shape in the comparison.</p>","steps":["If both nodes are null, return true.","If exactly one is null, return false.","If the values differ, return false.","Otherwise return <code>same(x.left, y.left) && same(x.right, y.right)</code>.","Iterative version: push the pair <code>(a, b)</code> onto a queue, apply the same three checks to each pair you take out, and push the two child pairs."],"pitfalls":["Comparing traversal value lists without null markers. Different shapes can produce the same list, like in the second example.","Checking <code>x.val === y.val</code> before checking for null. With one empty side that reads a property of null and throws.","Comparing left with right (the mirror check) instead of left with left."],"complexity":{"time":"O(min(n, m))","space":"O(h) for recursion, O(w) for the queue"}},"solutions":[{"title":"Recursive lockstep walk","idea":"Handle the null cases first, then compare values, then both child pairs.","time":"O(min(n, m))","space":"O(h)","ts":"function areTwins(a: TreeNode | null, b: TreeNode | null): boolean {\n  if (!a && !b) return true;\n  if (!a || !b) return false;\n  return a.val === b.val && areTwins(a.left, b.left) && areTwins(a.right, b.right);\n}","py":"class Solution:\n    def areTwins(self, a: Optional[TreeNode], b: Optional[TreeNode]) -> bool:\n        if not a and not b:\n            return True\n        if not a or not b:\n            return False\n        return a.val == b.val and self.areTwins(a.left, b.left) and self.areTwins(a.right, b.right)","js":"function areTwins(a, b) {\n  if (!a && !b) return true;\n  if (!a || !b) return false;\n  return a.val === b.val && areTwins(a.left, b.left) && areTwins(a.right, b.right);\n}"},{"title":"Queue of node pairs (BFS)","idea":"Keep a queue of (node from a, node from b) pairs. Check each pair the same way, then queue the left pair and the right pair.","time":"O(min(n, m))","space":"O(w)","ts":"function areTwins(a: TreeNode | null, b: TreeNode | null): boolean {\n  const queue: [TreeNode | null, TreeNode | null][] = [[a, b]];\n  for (let i = 0; i < queue.length; i++) {\n    const [x, y] = queue[i];\n    if (!x && !y) continue;\n    if (!x || !y || x.val !== y.val) return false;\n    queue.push([x.left, y.left], [x.right, y.right]);\n  }\n  return true;\n}","py":"class Solution:\n    def areTwins(self, a: Optional[TreeNode], b: Optional[TreeNode]) -> bool:\n        queue = deque([(a, b)])\n        while queue:\n            x, y = queue.popleft()\n            if not x and not y:\n                continue\n            if not x or not y or x.val != y.val:\n                return False\n            queue.append((x.left, y.left))\n            queue.append((x.right, y.right))\n        return True","js":"function areTwins(a, b) {\n  const queue = [[a, b]];\n  for (let i = 0; i < queue.length; i++) {\n    const [x, y] = queue[i];\n    if (!x && !y) continue;\n    if (!x || !y || x.val !== y.val) return false;\n    queue.push([x.left, y.left], [x.right, y.right]);\n  }\n  return true;\n}"}],"followups":["Check whether one tree is the mirror image of the other.","You need to compare one tree against thousands of others many times. How could you precompute something per tree so most comparisons take O(1)?"],"related":[],"kind":"function","nEx":3,"nBig":2,"lcTitle":"Same Tree","acc":0.00681701501221059,"co":[["Bloomberg",52,0],["Amazon",47,90],["Google",46,90],["Microsoft",45,30],["Meta",39,180],["tcs",36,180],["LinkedIn",32,0],["Apple",30,0],["Oracle",27,0]]}