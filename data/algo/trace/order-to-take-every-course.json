"ch":["b"]},{"l":14,"d":0,"fn":"courseOrder","v":{"indeg":[0,0,0,1]},"ch":["indeg"]},{"l":15,"d":0,"fn":"courseOrder","v":{}},{"l":13,"d":0,"fn":"courseOrder","v":{}},{"l":10,"d":0,"fn":"courseOrder","v":{}},{"l":11,"d":0,"fn":"courseOrder","v":{"a":1,"queue":[]},"ch":["a","queue"]},{"l":12,"d":0,"fn":"courseOrder","v":{"order":[2,0,1]},"ch":["order"]},{"l":13,"d":0,"fn":"courseOrder","v":{}},{"l":14,"d":0,"fn":"courseOrder","v":{"indeg":[0,0,0,0]},"ch":["indeg"]},{"l":15,"d":0,"fn":"courseOrder","v":{}},{"l":16,"d":0,"fn":"courseOrder","v":{"queue":[3]},"ch":["queue"]},{"l":13,"d":0,"fn":"courseOrder","v":{}},{"l":10,"d":0,"fn":"courseOrder","v":{}},{"l":11,"d":0,"fn":"courseOrder","v":{"a":3,"queue":[]},"ch":["a","queue"]},{"l":12,"d":0,"fn":"courseOrder","v":{"order":[2,0,1,3]},"ch":["order"]},{"l":13,"d":0,"fn":"courseOrder","v":{}},{"l":10,"d":0,"fn":"courseOrder","v":{}},{"l":17,"d":0,"fn":"courseOrder","v":{},"r":[2,0,1,3]}]},"jsMap":{"1":1,"2":2,"3":3,"4":4,"5":4,"6":4,"7":4,"8":5,"9":6,"10":7,"11":8,"12":9,"13":10,"14":11},"notes":{"ts":{"2":"<code>after[a]</code> lists the courses that course <code>a</code> unlocks.","3":"<code>indeg[b]</code> counts rules still blocking course <code>b</code>.","4":"Record each rule as an arrow and one more block on <code>b</code>.","5":"The answer, which also serves as the queue.","6":"Courses with no rules against them can be taken first.","7":"Take queued courses in order; <code>head</code> marks the next one to process.","8":"Look at each course this one unlocks.","9":"One block removed; with none left, that course can be taken next.","10":"If some course never got free, a loop blocked it: return an empty list."},"py":{"3":"<code>after[a]</code> lists the courses that course <code>a</code> unlocks.","4":"<code>indeg[b]</code> counts rules still blocking course <code>b</code>.","5":"Go through every rule.","6":"Record it as an arrow from <code>a</code> to <code>b</code>.","7":"One more rule blocks <code>b</code>.","8":"Courses with no rules against them can be taken first.","9":"Courses in the order they are taken.","10":"Keep going while some course is free to take.","11":"Take the next free course.","12":"It goes next in the order.","13":"Look at each course it unlocks.","14":"One block on that course is gone.","15":"No blocks left?","16":"Then that course is free to take.","17":"If some course never got free, a loop blocked it: return an empty list."}}}],"expected":[2,0,1,3],"compare":{"check":"(args, got, expected) => {\n      const [n, rules] = args;\n      // decide on our own whether any order exists (Kahn's algorithm)\n      const after = Array.from({ length: n }, () => []), indeg = new Array(n).fill(0);\n      for (const [a, b] of rules) { after[a].push(b); indeg[b]++; }\n      const q = [];\n      for (let i = 0; i < n; i++) if (indeg[i] === 0) q.push(i);\n      for (let h = 0; h < q.length; h++) for (const b of after[q[h]]) if (--indeg[b] === 0) q.push(b);\n      const possible = q.length === n;\n      if (!Array.isArray(got)) return false;\n      if (!possible) return got.length === 0;\n      if (got.length !== n) return false;\n      const pos = new Array(n).fill(-1);\n      for (let i = 0; i < n; i++) {\n        const c = got[i];\n        if (!Number.isInteger(c) || c < 0 || c >= n || pos[c] !== -1) return false; // out of range or repeated\n        pos[c] = i;\n      }\n      return rules.every(([a, b]) => pos[a] < pos[b]);\n    }"}}