,20349,54264,116280,203490,293930,352716,352716,293930,203490,116280,54264,20349,5985,1330,210,21,1],[1,22,231,1540,7315,26334,74613,170544,319770,497420,646646,705432,646646,497420,319770,170544,74613,26334,7315,1540,231,22,1],[1,23,253,1771,8855,33649,100947,245157,490314,817190,1144066,1352078,1352078,1144066,817190,490314,245157,100947,33649,8855,1771,253,23,1],[1,24,276,2024,10626,42504,134596,346104,735471,1307504,1961256,2496144,2704156,2496144,1961256,1307504,735471,346104,134596,42504,10626,2024,276,24,1],[1,25,300,2300,12650,53130,177100,480700,1081575,2042975,3268760,4457400,5200300,5200300,4457400,3268760,2042975,1081575,480700,177100,53130,12650,2300,300,25,1],[1,26,325,2600,14950,65780,230230,657800,1562275,3124550,5311735,7726160,9657700,10400600,9657700,7726160,5311735,3124550,1562275,657800,230230,65780,14950,2600,325,26,1],[1,27,351,2925,17550,80730,296010,888030,2220075,4686825,8436285,13037895,17383860,20058300,20058300,17383860,13037895,8436285,4686825,2220075,888030,296010,80730,17550,2925,351,27,1]]},{"args":[14],"expected":[[1],[1,1],[1,2,1],[1,3,3,1],[1,4,6,4,1],[1,5,10,10,5,1],[1,6,15,20,15,6,1],[1,7,21,35,35,21,7,1],[1,8,28,56,70,56,28,8,1],[1,9,36,84,126,126,84,36,9,1],[1,10,45,120,210,252,210,120,45,10,1],[1,11,55,165,330,462,462,330,165,55,11,1],[1,12,66,220,495,792,924,792,495,220,66,12,1],[1,13,78,286,715,1287,1716,1716,1287,715,286,78,13,1]]},{"args":[6],"expected":[[1],[1,1],[1,2,1],[1,3,3,1],[1,4,6,4,1],[1,5,10,10,5,1]]},{"args":[6],"expected":[[1],[1,1],[1,2,1],[1,3,3,1],[1,4,6,4,1],[1,5,10,10,5,1]]},{"args":[6],"expected":[[1],[1,1],[1,2,1],[1,3,3,1],[1,4,6,4,1],[1,5,10,10,5,1]]}],"gen":"(r, big) => [big ? 30 : r.int(1, 30)]","hints":["You only ever need the row directly above to build the next one.","Start each new row with 1. For each middle position j, add entries j − 1 and j of the previous row. End with 1.","Careful with rows 0 and 1: they have no middle entries, so the inner loop must not run for them."],"explain":{"intuition":"<p>Each row is fully decided by the row above it, so build top-down and keep everything you build. Entry <code>j</code> of row <code>i</code> is <code>prev[j − 1] + prev[j]</code>, and the two edges are always 1 because there is only one number above them.</p>\n<p>These are the binomial coefficients: entry <code>j</code> of row <code>i</code> counts the ways to choose <code>j</code> items from <code>i</code>. That gives a second way to build a row on its own, by multiplying across it: <code>C(i, j + 1) = C(i, j) · (i − j) / (j + 1)</code>.</p>","steps":["Start with an empty list of rows.","For <code>i</code> from 0 to <code>rows − 1</code>: begin the row with <code>[1]</code>.","For <code>j</code> from 1 to <code>i − 1</code>, push <code>previous[j − 1] + previous[j]</code>.","If <code>i &gt; 0</code>, push a closing 1. Add the row to the result.","Return all rows."],"pitfalls":["Building <code>rows + 1</code> rows by counting the top row as row 1 and also looping to <code>rows</code> inclusive.","Pushing a closing 1 on row 0, which gives <code>[1, 1]</code> as the top.","In the formula version, dividing before multiplying, which truncates: always multiply first, then divide."],"complexity":{"time":"O(rows²)","space":"O(rows²) for the output"}},"solutions":[{"title":"Build each row from the one above","idea":"Edges are 1; every middle entry is the sum of the two entries above it.","time":"O(rows²)","space":"O(rows²)","ts":"function neighbourSumTriangle(rows: number): number[][] {\n  const out: number[][] = [];\n  for (let i = 0; i < rows; i++) {\n    const row = [1];\n    for (let j = 1; j < i; j++) row.push(out[i - 1][j - 1] + out[i - 1][j]);\n    if (i > 0) row.push(1);\n    out.push(row);\n  }\n  return out;\n}","py":"class Solution:\n    def neighbourSumTriangle(self, rows: int) -> List[List[int]]:\n        out = []\n        for i in range(rows):\n            row = [1]\n            for j in range(1, i):\n                row.append(out[i - 1][j - 1] + out[i - 1][j])\n            if i > 0:\n                row.append(1)\n            out.append(row)\n        return out","js":"function neighbourSumTriangle(rows) {\n  const out = [];\n  for (let i = 0; i < rows; i++) {\n    const row = [1];\n    for (let j = 1; j < i; j++) row.push(out[i - 1][j - 1] + out[i - 1][j]);\n    if (i > 0) row.push(1);\n    out.push(row);\n  }\n  return out;\n}"},{"title":"Binomial coefficients across each row","idea":"Row i is C(i, 0), C(i, 1), …, C(i, i). Each one follows from the previous by multiplying by (i − j) and dividing by (j + 1).","time":"O(rows²)","space":"O(rows²)","ts":"function neighbourSumTriangle(rows: number): number[][] {\n  const out: number[][] = [];\n  for (let i = 0; i < rows; i++) {\n    const row = [1];\n    let c = 1;\n    for (let j = 0; j < i; j++) {\n      c = (c * (i - j)) / (j + 1); // exact: the product is always divisible\n      row.push(c);\n    }\n    out.push(row);\n  }\n  return out;\n}","py":"class Solution:\n    def neighbourSumTriangle(self, rows: int) -> List[List[int]]:\n        out = []\n        for i in range(rows):\n            row, c = [1], 1\n            for j in range(i):\n                c = c * (i - j) // (j + 1)\n                row.append(c)\n            out.append(row)\n        return out","js":"function neighbourSumTriangle(rows) {\n  const out = [];\n  for (let i = 0; i < rows; i++) {\n    const row = [1];\n    let c = 1;\n    for (let j = 0; j < i; j++) {\n      c = c * (i - j) / (j + 1);\n      row.push(c);\n    }\n    out.push(row);\n  }\n  return out;\n}"}],"followups":["Return only row k, using O(k) extra space.","Rows grow fast. Which row first overflows a 32-bit integer, and how would you return entries modulo a prime?"],"related":[],"kind":"function","nEx":3,"nBig":2,"lcTitle":"Pascal's Triangle","acc":0.007947626188829982,"co":[["Bank of America",100,90],["X",94,0],["Bloomberg",64,30],["Wipro",63,0],["Deutsche Bank",62,0],["Amazon",61,90],["Google",58,30],["Microsoft",55,90],["Accenture",54,0],["Zoho",52,0],["Apple",51,0],["Meta",51,180],["Goldman Sachs",48,0],["tcs",46,0],["Infosys",30,0]]}