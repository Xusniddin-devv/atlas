ull,408,null,409,null,410,null,411,null,412,null,413,null,414,null,415,null,416,null,417,null,418,null,419,null,420,null,421,null,422,null,423,null,424,null,425,null,426,null,427,null,428,null,429,null,430,null,431,null,432,null,433,null,434,null,435,null,436,null,437,null,438,null,439,null,440,null,441,null,442,null,443,null,444,null,445,null,446,null,447,null,448,null,449,null,450,null,451,null,452,null,453,null,454,null,455,null,456,null,457,null,458,null,459,null,460,null,461,null,462,null,463,null,464,null,465,null,466,null,467,null,468,null,469,null,470,null,471,null,472,null,473,null,474,null,475,null,476,null,477,null,478,null,479,null,480,null,481,null,482,null,483,null,484,null,485,null,486,null,487,null,488,null,489,null,490,null,491,null,492,null,493,null,494,null,495,null,496,null,497,null,498,null,499,null,500]},{"args":[[13,-2,-14,-1,17,1,2,-10,-11,14,5,-20],[13,-2,-14,2,1,17,-10,-1,-20,5,14,-11]],"expected":[-11,-1,14,-14,-10,null,5,-2,null,17,null,null,-20,13,null,null,1,null,null,null,null,null,2]},{"args":[[11,-4,13,16,-14,-18,14,3,-5],[-4,11,16,-5,3,14,-18,-14,13]],"expected":[13,11,-14,null,-4,16,-18,null,null,null,null,null,14,null,3,null,-5]},{"args":[[19,7,-15,2,-19,12,4],[19,-15,-19,2,7,4,12]],"expected":[12,7,4,19,2,null,null,null,null,-15,-19]},{"args":[[3],[3]],"expected":[3]},{"args":[[3,-4],[-4,3]],"expected":[3,null,-4]},{"args":[[-2,-12],[-2,-12]],"expected":[-12,-2]},{"args":[[-16,8,-4,-9,-5,4,9,13,-18,1],[8,-16,-5,-9,-4,-18,13,1,9,4]],"expected":[4,-4,9,-16,-9,null,1,null,8,null,-5,13,null,null,null,null,null,null,-18]},{"args":[[-6,4,13,18,5,-4,-15,11,3,-9,-5,-12],[-6,4,18,13,-4,-15,5,3,11,-5,-9,-12]],"expected":[-12,-9,null,11,-5,5,3,null,null,13,-15,null,null,4,18,-4,null,-6]},{"args":[[5,9,7],[7,9,5]],"expected":[5,null,9,null,7]},{"args":[[13],[13]],"expected":[13]}],"gen":"(r, big) => {\n  const nd = v => ({ v, L: null, R: null });\n  const put = (t, x, b) => { if (!t) return x; let c = t; for (;;) { const k = r.bool(b) ? \"L\" : \"R\"; if (!c[k]) { c[k] = x; return t; } c = c[k]; } };\n  const deep = (len, vals) => { let i = 0; const t = nd(vals[i++]); let c = t; for (; i < len; i++) { const k = r.bool() ? \"L\" : \"R\"; c[k] = nd(vals[i]); c = c[k]; } for (; i < vals.length; i++) put(c, nd(vals[i]), 0.5); return t; };\n  const vals = big ? r.distinct(100000, -1000000000, 1000000000) : r.distinct(r.int(1, 12), -20, 20);\n  let t = null;\n  if (big && r.bool()) t = deep(r.int(300, 420), vals);\n  else { const b = big ? 0.5 : r.pick([0.5, 0.5, 0.2, 0.8]); for (const v of vals) t = put(t, nd(v), b); }\n  const ino = [], st = [];\n  for (let n = t; n || st.length;) { while (n) { st.push(n); n = n.L; } n = st.pop(); ino.push(n.v); n = n.R; }\n  const rev = [], st2 = [t];\n  while (st2.length) { const n = st2.pop(); rev.push(n.v); if (n.L) st2.push(n.L); if (n.R) st2.push(n.R); }\n  return [ino, rev.reverse()];\n}","hints":["Which list tells you the root right away? Once you have it, what does the other list say about it?","The last postorder value is the root. Its position in inorder splits inorder into the left and right subtrees, and their sizes tell you which slice of postorder belongs to each.","Map each value to its inorder index. Then read postorder from the back with one pointer, and build the right subtree before the left one."],"explain":{"intuition":"<p>Postorder always ends with the root. Inorder puts the root <b>between</b> its two subtrees. So: take the root from the end of postorder, find it in inorder, and everything left of it is the left subtree, everything right of it the right subtree. Then do the same inside each part.</p>\n<p>Read backwards, postorder is: root, then the <b>whole right subtree</b>, then the left subtree. So if you consume postorder from the end with a single pointer and always build the right subtree first, the next value is always the root of the subtree you are about to build. Each call then only needs its inorder range <code>[lo, hi]</code>, and a hash map gives the split point in O(1). An empty range is a null child. It is the mirror image of building from preorder, where you go forward and build left first.</p>","steps":["Map each value to its index in <code>inorder</code>.","Keep a pointer <code>next = n − 1</code> into <code>postorder</code>.","<code>build(lo, hi)</code>: if <code>lo &gt; hi</code>, return null.","Take <code>val = postorder[next--]</code> as the root and look up its inorder index <code>mid</code>.","Build <code>right = build(mid + 1, hi)</code> <b>first</b>, then <code>left = build(lo, mid − 1)</code>. Call <code>build(0, n − 1)</code>."],"pitfalls":["Building the left subtree first while reading postorder from the back. Backwards postorder lists the right subtree first, so the roots get handed to the wrong side.","Slicing arrays at each call. It works but costs O(n · h) time and memory.","Taking the first postorder value as the root. That is the leftmost leaf's position in the walk, not the root."],"complexity":{"time":"O(n)","space":"O(n)"}},"solutions":[{"title":"Slice and search at every step","idea":"Root = last postorder value; find it in inorder; slice both lists into left and right parts and recurse. Clear, but every level rescans and copies.","time":"O(n · h)","space":"O(n · h)","slow":true,"ts":"function treeFromInPost(inorder: number[], postorder: number[]): TreeNode | null {\n  if (!postorder.length) return null;\n  const val = postorder[postorder.length - 1];\n  const root = new TreeNode(val);\n  const mid = inorder.indexOf(val); // size of the left subtree\n  root.left = treeFromInPost(inorder.slice(0, mid), postorder.slice(0, mid));\n  root.right = treeFromInPost(inorder.slice(mid + 1), postorder.slice(mid, postorder.length - 1));\n  return root;\n}","py":"class Solution:\n    def treeFromInPost(self, inorder: List[int], postorder: List[int]) -> Optional[TreeNode]:\n        if not postorder:\n            return None\n        root = TreeNode(postorder[-1])\n        mid = inorder.index(postorder[-1])  # size of the left subtree\n        root.left = self.treeFromInPost(inorder[:mid], postorder[:mid])\n        root.right = self.treeFromInPost(inorder[mid + 1:], postorder[mid:-1])\n        return root","js":"function treeFromInPost(inorder, postorder) {\n  if (!postorder.length) return null;\n  const val = postorder[postorder.length - 1];\n  const root = new TreeNode(val);\n  const mid = inorder.indexOf(val);\n  root.left = treeFromInPost(inorder.slice(0, mid), postorder.slice(0, mid));\n  root.right = treeFromInPost(inorder.slice(mid + 1), postorder.slice(mid, postorder.length - 1));\n  return root;\n}"},{"title":"Index map and one pointer from the back","idea":"Consume postorder from the end; each value is the root of the next subtree to build, as long as the right subtree is built before the left.","time":"O(n)","space":"O(n)","ts":"function treeFromInPost(inorder: number[], postorder: number[]): TreeNode | null {\n  const pos = new Map<number, number>();\n  inorder.forEach((v, i) => pos.set(v, i));\n  let next = postorder.length - 1;\n  const build = (lo: number, hi: number): TreeNode | null => {\n    if (lo > hi) return null;\n    const val = postorder[next--];\n    const mid = pos.get(val)!;\n    const node = new TreeNode(val);\n    node.right = build(mid + 1, hi); // right first: backwards postorder lists it first\n    node.left = build(lo, mid - 1);\n    return node;\n  };\n  return build(0, inorder.length - 1);\n}","py":"class Solution:\n    def treeFromInPost(self, inorder: List[int], postorder: List[int]) -> Optional[TreeNode]:\n        pos = {v: i for i, v in enumerate(inorder)}\n        nxt = len(postorder) - 1\n\n        def build(lo, hi):\n            nonlocal nxt\n            if lo > hi:\n                return None\n            val = postorder[nxt]\n            nxt -= 1\n            mid = pos[val]\n            node = TreeNode(val)\n            node.right = build(mid + 1, hi)  # right first: backwards postorder lists it first\n            node.left = build(lo, mid - 1)\n            return node\n\n        return build(0, len(inorder) - 1)","js":"function treeFromInPost(inorder, postorder) {\n  const pos = /* @__PURE__ */ new Map();\n  inorder.forEach((v, i) => pos.set(v, i));\n  let next = postorder.length - 1;\n  const build = (lo, hi) => {\n    if (lo > hi) return null;\n    const val = postorder[next--];\n    const mid = pos.get(val);\n    const node = new TreeNode(val);\n    node.right = build(mid + 1, hi);\n    node.left = build(lo, mid - 1);\n    return node;\n  };\n  return build(0, inorder.length - 1);\n}"}],"followups":["Can you rebuild a tree from preorder and postorder alone? When is the answer not unique?","Rewrite the O(n) version without recursion, for trees that are 100 000 levels deep."],"related":[],"kind":"function","nEx":3,"nBig":2,"lcTitle":"Construct Binary Tree from Inorder and Postorder Traversal","acc":0.006980947305398868,"co":[["Walmart Labs",60,0],["Microsoft",36,0],["TikTok",26,0],["Google",23,90],["Amazon",20,0],["Bloomberg",8,0],["Meta",5,0]]}