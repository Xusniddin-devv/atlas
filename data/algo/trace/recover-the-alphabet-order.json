n where the two words differ.","7":"Skip the shared opening of the two words.","8":"One word is a prefix of the other: fine if the shorter is first, impossible otherwise.","9":"The first difference says <code>a[j]</code> comes before <code>b[j]</code>.","11":"<code>state</code> marks a letter as on the current search path (1) or finished (2).","12":"<code>post</code> lists letters in the order their searches finish.","13":"<code>visit(ch)</code> finishes every letter after <code>ch</code>, returning false if it meets a loop.","14":"Reaching a letter still on the path means the rules loop back on themselves.","15":"This letter and everything after it are already finished.","16":"Put <code>ch</code> on the current path.","17":"Finish every letter that must follow <code>ch</code>; pass any loop upward.","18":"Every follower is done, so <code>ch</code> is finished.","19":"A letter finishes only after every letter that must follow it.","20":"No loop was found below <code>ch</code>.","22":"Search from every letter; any loop means no valid order exists.","23":"Reversed finishing order puts every letter before its followers."},"py":{"3":"<code>after[x]</code> will hold letters known to follow <code>x</code>; every letter starts with none.","4":"Compare each neighbouring pair of words in the list.","5":"Walk both words side by side.","6":"The first differing letters reveal one rule.","7":"Record that <code>x</code> comes before <code>y</code>.","8":"Later letters say nothing, because the words already differ here.","9":"No difference was found: one word is a prefix of the other.","10":"Is the longer word listed before its own prefix?","11":"Then no order can make the list sorted.","12":"<code>state</code> marks a letter as on the current search path (1) or finished (2).","13":"<code>post</code> lists letters in the order their searches finish.","15":"<code>visit(ch)</code> finishes every letter after <code>ch</code>, returning false if it meets a loop.","16":"Reaching a letter still on the path means the rules loop back on themselves.","17":"Report the loop.","18":"Was this letter already finished earlier?","19":"Then it and its followers need no more work.","20":"Put <code>ch</code> on the current path.","21":"Visit every letter that must follow <code>ch</code>.","22":"Search from this follower; did it meet a loop?","23":"Then pass the failure upward.","24":"Every follower is done, so <code>ch</code> is finished.","25":"A letter finishes only after every letter that must follow it.","26":"No loop was found below <code>ch</code>.","28":"Search from every letter.","29":"Did that search meet a loop?","30":"Then no valid order exists.","31":"Reversed finishing order puts every letter before its followers."}}}],"expected":"kqtr","compare":{"check":"(args, got, expected) => {\n      const words = args[0];\n      const letters = new Set(words.join(\"\"));\n      const rules = [];\n      let ok = true;\n      for (let i = 0; i + 1 < words.length && ok; i++) {\n        const a = words[i], b = words[i + 1], m = Math.min(a.length, b.length);\n        let j = 0;\n        while (j < m && a[j] === b[j]) j++;\n        if (j === m) { if (a.length > b.length) ok = false; }\n        else rules.push([a[j], b[j]]);\n      }\n      if (ok) {\n        // the rules must have no loop: peel off letters with nothing before them\n        const indeg = new Map([...letters].map(c => [c, 0])), out = new Map([...letters].map(c => [c, []]));\n        for (const [x, y] of rules) { out.get(x).push(y); indeg.set(y, indeg.get(y) + 1); }\n        const q = [...letters].filter(c => indeg.get(c) === 0);\n        for (let i = 0; i < q.length; i++) for (const y of out.get(q[i])) { indeg.set(y, indeg.get(y) - 1); if (indeg.get(y) === 0) q.push(y); }\n        if (q.length !== letters.size) ok = false;\n      }\n      if (!ok) return got === \"\";\n      if (typeof got !== \"string\" || got.length !== letters.size) return false;\n      const pos = new Map();\n      for (let i = 0; i < got.length; i++) { if (!letters.has(got[i]) || pos.has(got[i])) return false; pos.set(got[i], i); }\n      return rules.every(([x, y]) => pos.get(x) < pos.get(y));\n    }"}}